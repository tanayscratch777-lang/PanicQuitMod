{
  "schemaVersion": 1,
  "id": "modid",
  "version": "${version}",
  "name": "Panic Quit Mod",
  "description": "Instantly minimizes, saves and exits Minecraft.",
  "authors": [
    "Me"
  ],
  "contact": {},
  "license": "CC0-1.0",
  "icon": "assets/modid/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.ExampleMod"
    ],
    "client": [
      "com.example.ExampleModClient"
    ]
  },
  "mixins": [
    "modid.mixins.json",
    {
      "config": "modid.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}